{
  "name": "stltools",
  "version": "1.0.1-mts.1",
  "description": "Parametric STL generator for drone, RC, robotics and workshop parts: thousands of presets, assemblies, print time estimates, Klipper printer status (view only). Web UI + CLI.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "stltools": "bin/stltools.js",
    "stltools-app": "bin/stltools-app.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "app": "node bin/stltools-app.js",
    "package": "node scripts/package.mjs",
    "test": "node --test test/*.test.js",
    "examples": "node bin/stltools.js gen parts-box -o out && node bin/stltools.js gen rc-wing -o out"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsecfreak/STLTools.git"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@fontsource/roboto-condensed": "5.2.8",
    "manifold-3d": "3.5.3",
    "opentype.js": "1.3.4",
    "three": "0.170.0"
  },
  "author": "opsecfreak",
  "homepage": "https://github.com/opsecfreak/STLTools#readme",
  "bugs": {
    "url": "https://github.com/opsecfreak/STLTools/issues"
  },
  "keywords": [
    "stl",
    "3d-printing",
    "parametric",
    "cad",
    "drone",
    "rc",
    "robotics",
    "klipper",
    "manifold"
  ],
  "files": [
    "bin/",
    "src/",
    "public/",
    "presets/",
    "printer-profiles/",
    "seed/",
    "custom/",
    "deploy/",
    "docs/",
    "!docs/screenshots/",
    "AGENTS.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
